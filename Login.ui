     <property name="styleSheet">
      <string notr="true">/* ===== LINEEDIT ARRONDI AVEC BORDURE VIOLETTE ===== */
QLineEdit {
    background-color: #FFFFFF;
    border: 2px solid #D1C4E9;          /* Violet clair */
    border-radius: 12px;                /* Arrondi */
    padding: 12px 16px;
    color: #2C3E50;
    font-size: 14px;
    font-weight: 500;
    selection-background-color: #9B59B6;
    selection-color: white;
    transition: border 0.3s ease;
}

/* Au survol */
QLineEdit:hover {
    border: 2px solid #9B59B6;          /* Violet plus foncé */
    background-color: #FDFAFF;
}</string>
