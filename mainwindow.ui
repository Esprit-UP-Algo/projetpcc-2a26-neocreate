          <property name="styleSheet">
           <string notr="true">QGroupBox {
    border: 2px solid #9B59B6;
    border-radius: 15px;
    margin-top: 20px;
    background: qlineargradient(spread:pad,
                                x1:0, y1:0,
                                x2:1, y2:0,
                                stop:0 #9B59B6,
                                stop:1 #BDC3C7);
    color: white;
    font-weight: bold;
    padding: 15px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top centre; 
    padding: 10px 20px; 
    border-radius: 15px; 
    background: qlineargradient(spread:pad,
                                x1:0, y1:0,
                                x2:1, y2:0,
                                stop:0 #9B59B6,
                                stop:1 #BDC3C7);
    color: black; 
    font-size: 20px; 
    font-weight: bold;

}</string>
          </property>
