      <property name="styleSheet">
       <string notr="true">QMainWindow, QWidget {
    background-color: #BDC3C7;
}

QTabWidget::pane {
    border: 2px solid #BDC3C7;
    border-radius: 15px;
    background-color: #BDC3C7;
}


QTabBar::tab {
    background: transparent;
    color: black;
    padding: 8px 20px;
    margin: 4px;
    border: 1px solid #999;
    border-radius: 15px;
    font-weight: bold;
}


QTabBar::tab:selected {
    background: #95A5A6;        
    color: white;
}


QTabBar::tab:hover {
    background: #A7B1B1;         
    color: white;
}


QTabWidget &gt; QWidget {
    background-color: #BDC3C7;
}</string>
